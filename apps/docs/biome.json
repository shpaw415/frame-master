{
	"$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
	"root": false,
	"extends": "//",
	"files": {
		"includes": ["src/**", "frame-master.config.ts", "plugins/**"]
	},
	"linter": {
		"rules": {
			"complexity": {
				"noArguments": "off"
			},
			"security": {
				"noDangerouslySetInnerHtml": "off"
			}
		}
	}
}
