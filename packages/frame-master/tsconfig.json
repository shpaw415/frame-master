{
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,
		"types": ["bun"],
		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		// Some stricter flags (disabled by default)
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false,
		"paths": {
			"frame-master/*": ["./src/*"],
			"frame-master/plugin": ["./src/plugins/index.ts"],
			"frame-master/plugin/types": ["./src/plugins/types.ts"],
			"frame-master/plugin/react": ["./src/plugins/react-stack/index.ts"],
			"frame-master/server": ["./src/server/index.ts"],
			"frame-master/runtime": ["./src/server/runtime-loader.ts"],
			"frame-master/server/types": ["./src/server/type.ts"],
			"frame-master/server/request": ["./src/server/request-manager.ts"],
			"frame-master/config": ["./src/server/config.ts"],
			"frame-master/build": ["./src/build/index.ts"],
			"frame-master/testing": ["./test-suite/index.ts"],
			"frame-master/test-suite": ["./test-suite/index.ts"]
		}
	},
	"include": ["src", "bin", "config", "test", "test_project", "test-suite"],
	"exclude": ["**/node_modules", "**/*.template.ts"]
}
